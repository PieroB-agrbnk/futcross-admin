# Copia este archivo como  .streamlit/secrets.toml  y completa tus datos.
# NUNCA subas secrets.toml a GitHub (ya esta en .gitignore).

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "eyJ...service_role..."   # Supabase > Settings > API > service_role

# Dos claves distintas, dos niveles de acceso:
ADMIN_PIN      = "clave-de-administracion"  # ve todo: paquetes, precios, ingresos
ENTRENADOR_PIN = "clave-de-entrenadores"    # solo Panel, asistencia, alumnos y renovaciones
